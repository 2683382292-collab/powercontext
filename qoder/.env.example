# 个性化复习助手 —— 环境变量样例
# 复制为 qoder/.env 后按需修改；应用启动时会自动读取（若存在）。
# 注意：请勿把 .env 或任何令牌提交到仓库。

# PowerContext Server 地址（默认本地回环）
POWERCONTEXT_URL=http://127.0.0.1:8000

# 若 Server 开启了鉴权（POWERCONTEXT_SERVER_ACCESS_MODE=enforced），填写其 Bearer 令牌；
# 默认的本地回环安装无需鉴权，留空即可。
POWERCONTEXT_TOKEN=

# 学习者 Scope 前缀：每个学习者会创建一个独立 Scope（idempotency_key = 前缀-学习者ID）
REVIEW_SCOPE_PREFIX=qoder-review

# 复习助手网页服务监听地址与端口
REVIEW_HOST=127.0.0.1
REVIEW_PORT=8080

# 每轮复习默认出题数量
REVIEW_SESSION_SIZE=5
